{
  "name": "@dae/device-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog.json": "./data/catalog.json"
  },
  "scripts": {
    "build": "tsc -b && node ./scripts/copy-data.mjs",
    "sync": "tsx ./scripts/sync.ts",
    "verify": "tsx ./scripts/verify.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dae/shared": "workspace:*",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "@types/node": "22.10.5"
  }
}
