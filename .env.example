# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=log

# ─── Persistence ─────────────────────────────────────────────────────────────
# filesystem: JSON records under DATA_DIR, no external services required.
# postgres:   Prisma + PostgreSQL (requires DATABASE_URL and a migration run).
STORAGE_DRIVER=filesystem
DATA_DIR=./.data
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dae?schema=public

# ─── Asset storage ───────────────────────────────────────────────────────────
# Uploaded designs are private: they are served only through signed, expiring URLs.
ASSET_STORE=local
ASSET_DIR=./.storage
# MUST be changed in production; the server refuses to start with the default.
ASSET_URL_SECRET=dev-only-change-me-in-production
ASSET_URL_TTL_SECONDS=900
# S3-compatible storage (set ASSET_STORE=s3):
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Maximum accepted upload / captured-render size, in bytes.
MAX_UPLOAD_BYTES=26214400

# ─── Background jobs ─────────────────────────────────────────────────────────
# inline: run in-process (default, no Redis needed). bullmq: requires REDIS_URL.
QUEUE_DRIVER=inline
# REDIS_URL=redis://localhost:6379

# ─── Figma ───────────────────────────────────────────────────────────────────
# Server-side only. Never exposed to the browser.
# FIGMA_ACCESS_TOKEN=

# ─── AI (optional) ───────────────────────────────────────────────────────────
# none:   deterministic pipeline only. Everything works; bitmaps simply carry
#         no structural analysis.
# openai: enables OCR / region analysis for bitmap sources.
AI_PROVIDER=none
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Hard gate: even with a key set, no user artwork leaves this process unless
# this is explicitly true.
AI_ALLOW_SOURCE_UPLOAD=false

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
# Tighter budget for upload / render / validate / export.
RATE_LIMIT_EXPENSIVE_LIMIT=60

# ─── Administrative endpoints ────────────────────────────────────────────────
# POST /device-catalog/sync is disabled unless this is set.
# ADMIN_API_TOKEN=

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=dae-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Web app (apps/web) ──────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
